# Use a URL-safe password because Compose also inserts it into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password
# Optional: local dashboard port. The web service binds to 127.0.0.1 only.
WEB_PORT=5000

